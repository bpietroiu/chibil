@@ -2501,6 +2506,508 @@ make_child (char *command, int flags)
   return (pid);
 }
 
+#if defined (CHIBIL_REEXEC)
+#if defined (CHIBIL_SANDBOX)
+/* On the in-process sandbox PAL there is no real OS process to re-exec: a "fork"
+   that runs bash code becomes a new in-process green-process running the SAME bash
+   image. SandboxPal exposes that as SYS_spawn_self (spawn self image with an argv
+   and an fd map), reaped through the normal waitpid path (SYS_wait4). */
+extern long __chibil_syscall (long, long, long, long, long, long, long);
+#define SANDBOX_SYS_spawn_self 0x1003
+#define SANDBOX_SYS_spawn_tool 0x1004
+#endif
+/* To re-exec bash for a subshell/comsub on CoreCLR we must relaunch the actual
+   process that runs us — typically `dotnet bash.dll` — not bash.dll alone (a
+   managed dll is not directly executable). Reconstruct the launcher prefix from
+   /proc/self/cmdline: every argv entry up to and including the first that ends in
+   ".dll" (i.e. `dotnet /path/bash.dll`); if none, the process is a native apphost
+   so the prefix is just argv[0]. Cached after first use. The .dll path is made
+   absolute so a comsub that changes directory before a nested comsub still finds
+   it. Returns a NULL-terminated argv prefix, or NULL on failure. */
+static char **chibil_launcher = (char **)NULL;
+static int chibil_launcher_n = 0;
+
+static char **
+chibil_reexec_prefix (int *np)
+{
+  int fd, total, r, n, i, prefix, l;
+  char buf[8192], **args, *abspath, rp[4096];
+
+  if (chibil_launcher)
+    {
+      if (np) *np = chibil_launcher_n;
+      return (chibil_launcher);
+    }
+
+  fd = open ("/proc/self/cmdline", O_RDONLY);
+  if (fd < 0)
+    return ((char **)NULL);
+  total = 0;
+  while (total < (int)sizeof (buf) - 1 && (r = read (fd, buf + total, sizeof (buf) - 1 - total)) > 0)
+    total += r;
+  close (fd);
+  if (total <= 0)
+    return ((char **)NULL);
+  buf[total] = '\0';
+
+  /* Split the NUL-separated argv. */
+  args = (char **)NULL;
+  n = 0;
+  for (i = 0; i < total; )
+    {
+      char *s = buf + i;
+      args = (char **)xrealloc (args, (n + 2) * sizeof (char *));
+      args[n++] = s;			/* into buf; copied below */
+      i += strlen (s) + 1;
+    }
+
+  /* Find the launcher prefix length. */
+  prefix = 1;
+  for (i = 0; i < n; i++)
+    {
+      l = strlen (args[i]);
+      if (l >= 4 && strcmp (args[i] + l - 4, ".dll") == 0)
+	{ prefix = i + 1; break; }
+    }
+
+  chibil_launcher = (char **)xmalloc ((prefix + 1) * sizeof (char *));
+  for (i = 0; i < prefix; i++)
+    {
+      l = strlen (args[i]);
+      if (l >= 4 && strcmp (args[i] + l - 4, ".dll") == 0 &&
+	  (abspath = realpath (args[i], rp)) != 0)
+	chibil_launcher[i] = savestring (abspath);
+      else
+	chibil_launcher[i] = savestring (args[i]);
+    }
+  chibil_launcher[prefix] = (char *)NULL;
+  chibil_launcher_n = prefix;
+  free (args);
+
+  if (np) *np = chibil_launcher_n;
+  return (chibil_launcher);
+}
+
+/* Parent-side job bookkeeping shared by the posix_spawn paths — identical to
+   make_child's parent branch. Caller has already blocked SIGCHLD/SIGINT/SIGTERM
+   into oset; this restores the mask. */
+static void
+chibil_register_spawned (char *command, pid_t pid, int flags, int async_p, sigset_t *oset)
+{
+  PROCESS *child;
+
+  if (job_control)
+    {
+      if (pipeline_pgrp == 0)
+	pipeline_pgrp = pid;
+      if ((flags & FORK_NOJOB) == 0)
+	setpgid (pid, pipeline_pgrp);
+    }
+  else if (pipeline_pgrp == 0)
+    pipeline_pgrp = shell_pgrp;
+
+  child = add_process (command, pid);
+  if (flags & FORK_PROCSUB)
+    child->flags |= PROC_PROCSUB;
+  if (flags & FORK_COMSUB)
+    child->flags |= PROC_COMSUB;
+
+  if (async_p)
+    last_asynchronous_pid = pid;
+
+  delete_old_job (pid);
+  bgp_delete (pid);
+  last_made_pid = pid;
+  js.c_totforked++;
+  js.c_living++;
+
+  sigprocmask (SIG_SETMASK, oset, (sigset_t *)NULL);
+}
+
+#if defined (CHIBIL_SANDBOX)
+/* M5: exec an external command as a managed coreutil green-process. PATH resolved
+   COMMAND to a path; its basename names a registered managed tool (e.g. "cat").
+   SYS_spawn_tool spawns that tool's image with ARGV and the parent's std fds
+   inherited (or this stage's pipe ends). Returns the child pid (registered for
+   wait_for), or -1 if the basename is not a registered tool. */
+pid_t
+chibil_spawn_tool (char *command, char *path, char **argv, int pipe_in, int pipe_out, int flags)
+{
+  sigset_t set, oset;
+  pid_t pid;
+  char *base;
+  int fdmap[6], async_p;
+
+  base = strrchr (path, '/');
+  base = base ? base + 1 : path;
+
+  sigemptyset (&set);
+  sigaddset (&set, SIGCHLD);
+  sigaddset (&set, SIGINT);
+  sigaddset (&set, SIGTERM);
+  sigemptyset (&oset);
+  sigprocmask (SIG_BLOCK, &set, &oset);
+
+  making_children ();
+  async_p = (flags & FORK_ASYNC);
+
+  fdmap[0] = 0; fdmap[1] = (pipe_in  == NO_PIPE) ? 0 : pipe_in;
+  fdmap[2] = 1; fdmap[3] = (pipe_out == NO_PIPE) ? 1 : pipe_out;
+  fdmap[4] = 2; fdmap[5] = 2;
+  pid = (pid_t) __chibil_syscall (SANDBOX_SYS_spawn_tool, (long)(intptr_t) base,
+				  (long)(intptr_t) argv, (long)(intptr_t) fdmap, 3, 0, 0);
+
+  if (pid < 0)			/* basename is not a registered managed tool */
+    {
+      sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+      return (-1);
+    }
+
+  chibil_register_spawned (command ? savestring (command) : (char *)NULL, pid, flags, async_p, &oset);
+  return (pid);
+}
+
+/* Spawn a fresh bash green-process to run STRING — a deparsed subshell body — as a
+   subshell: an isolated process whose stdin/stdout/stderr are the PARENT's (or a
+   pipeline stage's pipe_in/pipe_out), and whose variable/function/option changes do
+   not leak back. The parent's functions + non-exported vars + positional params are
+   transferred via the prepended chibil_state_dump (same as comsub). The parent waits
+   for the returned pid exactly as for a forked subshell. Returns the pid, or -1. */
+pid_t
+chibil_spawn_subshell (char *string, int pipe_in, int pipe_out, int flags)
+{
+  sigset_t set, oset;
+  pid_t pid;
+  char *chibil_dump, *chibil_body, *cargv[6];
+  int fdmap[6], async_p;
+
+  chibil_dump = chibil_state_dump ();
+  if (chibil_dump && *chibil_dump)
+    {
+      size_t dl = strlen (chibil_dump), sl = strlen (string);
+      chibil_body = (char *) xmalloc (dl + 1 + sl + 1);
+      memcpy (chibil_body, chibil_dump, dl);
+      chibil_body[dl] = '\n';
+      memcpy (chibil_body + dl + 1, string, sl + 1);
+    }
+  else
+    chibil_body = string;
+
+  cargv[0] = "bash";
+  cargv[1] = "--norc";
+  cargv[2] = "--noprofile";
+  cargv[3] = "-c";
+  cargv[4] = chibil_body;
+  cargv[5] = (char *) NULL;
+
+  sigemptyset (&set);
+  sigaddset (&set, SIGCHLD);
+  sigaddset (&set, SIGINT);
+  sigaddset (&set, SIGTERM);
+  sigemptyset (&oset);
+  sigprocmask (SIG_BLOCK, &set, &oset);
+
+  making_children ();
+  async_p = (flags & FORK_ASYNC);
+
+  /* Inherit the parent's std fds, except a pipeline stage's ends. */
+  fdmap[0] = 0; fdmap[1] = (pipe_in  == NO_PIPE) ? 0 : pipe_in;
+  fdmap[2] = 1; fdmap[3] = (pipe_out == NO_PIPE) ? 1 : pipe_out;
+  fdmap[4] = 2; fdmap[5] = 2;
+  pid = (pid_t) __chibil_syscall (SANDBOX_SYS_spawn_self,
+				  (long)(intptr_t) cargv, (long)(intptr_t) fdmap, 3, 0, 0, 0);
+
+  if (chibil_body != string)
+    free (chibil_body);
+  if (chibil_dump)
+    free (chibil_dump);
+
+  if (pid < 0)
+    {
+      sys_error ("%s", "subshell: cannot spawn (SYS_spawn_self)");
+      sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+      return (-1);
+    }
+
+  chibil_register_spawned ((char *)NULL, pid, flags, async_p, &oset);
+  return (pid);
+}
+#endif
+
+/* Spawn a fresh bash to run STRING as a command substitution, with its stdout
+   wired to the comsub pipe (fildes[1]); the parent reads fildes[0] and waits for
+   the returned pid exactly as it does for a forked comsub child. envp is bash's
+   export environment (exported vars). Non-exported vars/functions are not yet
+   transferred (M-fork-2b). Returns the child pid, or -1 on failure. */
+pid_t
+chibil_spawn_comsub (char *string, int *fildes, char **envp, int flags)
+{
+  sigset_t set, oset;
+  pid_t pid;
+  posix_spawnattr_t attr;
+  posix_spawn_file_actions_t fa;
+  char **prefix, **argv, *chibil_dump, *chibil_body;
+  int np, i, r, async_p;
+
+#if !defined (CHIBIL_SANDBOX)
+  prefix = chibil_reexec_prefix (&np);
+  if (prefix == 0)
+    {
+      sys_error ("%s", "command substitution: cannot find launcher (/proc/self/cmdline)");
+      return (-1);
+    }
+#else
+  (void) prefix; (void) np; (void) r;   /* no launcher: spawn self in-process */
+#endif
+
+  /* Prepend the parent's functions + non-exported scalar vars (as re-executable
+     shell code) to the body, so the comsub child can call functions and read
+     non-exported vars. Exported vars still arrive via the environment. */
+  chibil_dump = chibil_state_dump ();
+  if (chibil_dump && *chibil_dump)
+    {
+      size_t dl = strlen (chibil_dump), sl = strlen (string);
+      chibil_body = (char *)xmalloc (dl + 1 + sl + 1);
+      memcpy (chibil_body, chibil_dump, dl);
+      chibil_body[dl] = '\n';
+      memcpy (chibil_body + dl + 1, string, sl + 1);
+    }
+  else
+    chibil_body = string;
+
+#if defined (CHIBIL_SANDBOX)
+  /* In-process green-process spawn: argv = bash --norc --noprofile -c BODY; the
+     child's stdout (fd 1) is wired to the pipe write end fildes[1] via the fd map.
+     A command substitution is a clean non-interactive subshell: no rc/profile. */
+  {
+    char *cargv[6];
+    int fdmap[2];
+    cargv[0] = "bash";
+    cargv[1] = "--norc";
+    cargv[2] = "--noprofile";
+    cargv[3] = "-c";
+    cargv[4] = chibil_body;
+    cargv[5] = (char *)NULL;
+
+    sigemptyset (&set);
+    sigaddset (&set, SIGCHLD);
+    sigaddset (&set, SIGINT);
+    sigaddset (&set, SIGTERM);
+    sigemptyset (&oset);
+    sigprocmask (SIG_BLOCK, &set, &oset);
+
+    making_children ();
+    async_p = (flags & FORK_ASYNC);
+
+    fdmap[0] = 1;            /* child fd 1  <-  parent fildes[1] (pipe write end) */
+    fdmap[1] = fildes[1];
+    pid = (pid_t) __chibil_syscall (SANDBOX_SYS_spawn_self,
+				    (long)(intptr_t) cargv, (long)(intptr_t) fdmap, 1, 0, 0, 0);
+
+    if (chibil_body != string)
+      free (chibil_body);
+    if (chibil_dump)
+      free (chibil_dump);
+
+    if (pid < 0)
+      {
+	sys_error ("%s", "command substitution: cannot spawn (SYS_spawn_self)");
+	sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+	return (-1);
+      }
+
+    chibil_register_spawned ((char *)NULL, pid, flags, async_p, &oset);
+    return (pid);
+  }
+#else
+  /* argv = [launcher...] --norc --noprofile -c BODY NULL. A command substitution
+     is a clean non-interactive subshell: it must not source rc / profile files
+     (which would also be slow and could recurse into more comsubs). */
+  argv = (char **)xmalloc ((np + 5) * sizeof (char *));
+  for (i = 0; i < np; i++)
+    argv[i] = prefix[i];
+  argv[np] = "--norc";
+  argv[np + 1] = "--noprofile";
+  argv[np + 2] = "-c";
+  argv[np + 3] = chibil_body;
+  argv[np + 4] = (char *)NULL;
+
+  sigemptyset (&set);
+  sigaddset (&set, SIGCHLD);
+  sigaddset (&set, SIGINT);
+  sigaddset (&set, SIGTERM);
+  sigemptyset (&oset);
+  sigprocmask (SIG_BLOCK, &set, &oset);
+
+  making_children ();
+  async_p = (flags & FORK_ASYNC);
+
+  posix_spawnattr_init (&attr);
+  {
+    short f = POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF;
+    sigset_t empty, dfl;
+    sigemptyset (&empty);
+    posix_spawnattr_setsigmask (&attr, &empty);
+    sigemptyset (&dfl);
+    sigaddset (&dfl, SIGINT);
+    sigaddset (&dfl, SIGQUIT);
+    sigaddset (&dfl, SIGTERM);
+    posix_spawnattr_setsigdefault (&attr, &dfl);
+    if (job_control && (flags & FORK_NOJOB) == 0)
+      {
+	posix_spawnattr_setpgroup (&attr, pipeline_pgrp);
+	f |= POSIX_SPAWN_SETPGROUP;
+      }
+    posix_spawnattr_setflags (&attr, f);
+  }
+
+  /* Child: stdout -> pipe write end, then close both pipe fds. */
+  posix_spawn_file_actions_init (&fa);
+  posix_spawn_file_actions_adddup2 (&fa, fildes[1], 1);
+  if (fildes[1] != 1)
+    posix_spawn_file_actions_addclose (&fa, fildes[1]);
+  posix_spawn_file_actions_addclose (&fa, fildes[0]);
+
+  /* posix_spawnP: the launcher (e.g. "dotnet") is usually a bare name found via
+     PATH, not an absolute path; posix_spawn would not search PATH. envp is
+     bash's export environment (exported vars); non-exported vars + functions
+     reach the child through the prepended state dump instead. */
+  r = posix_spawnp (&pid, argv[0], &fa, &attr, argv, envp ? envp : environ);
+
+  posix_spawn_file_actions_destroy (&fa);
+  posix_spawnattr_destroy (&attr);
+  free (argv);				/* elements owned by prefix/caller */
+  if (chibil_body != string)
+    free (chibil_body);
+  if (chibil_dump)
+    free (chibil_dump);
+
+  if (r != 0)
+    {
+      errno = r;
+      sys_error ("posix_spawn: %s", prefix[0]);
+      sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+      return (-1);
+    }
+
+  chibil_register_spawned ((char *)NULL, pid, flags, async_p, &oset);
+  return (pid);
+#endif /* !CHIBIL_SANDBOX */
+}
+
+/* CoreCLR has no usable fork(): a real fork() clones the process but the CLR's
+   GC/JIT/finalizer threads do not survive, leaving locks held and the heap
+   inconsistent — and this corrupts even the PARENT, which then faults
+   non-deterministically in the job/reaping layer. So instead of forking and
+   running bash's child setup in-process, we spawn a real OS process with
+   posix_spawn (which clones only enough to exec, never the CLR) and do the SAME
+   parent-side job bookkeeping make_child does. Used for the simple external
+   command case (no in-process child body, no pipes/redirections — the caller
+   prepares argv/envp/path). */
+pid_t
+make_child_posix_spawn (char *command, char *path, char **argv, char **envp,
+			int pipe_in, int pipe_out, struct fd_bitmap *fds_to_close,
+			int flags)
+{
+  sigset_t set, oset;
+  pid_t pid;
+  int r, async_p, have_fa, i;
+  posix_spawnattr_t attr;
+  posix_spawn_file_actions_t fa;
+
+  /* Block the same signals make_child blocks across child creation. */
+  sigemptyset (&set);
+  sigaddset (&set, SIGCHLD);
+  sigaddset (&set, SIGINT);
+  sigaddset (&set, SIGTERM);
+  sigemptyset (&oset);
+  sigprocmask (SIG_BLOCK, &set, &oset);
+
+  making_children ();
+  async_p = (flags & FORK_ASYNC);
+
+  if (default_buffered_input != -1 && (!async_p || default_buffered_input > 0))
+    sync_buffered_stream (default_buffered_input);
+
+  /* Configure the child: restore a default signal mask + default dispositions
+     for the signals make_child's child resets, and (under job control) place it
+     in the pipeline process group. posix_spawn applies these in the child
+     before exec, so the spawned program starts in the same state a forked +
+     exec'd bash child would. */
+  posix_spawnattr_init (&attr);
+  {
+    short f = POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF;
+    sigset_t empty, dfl;
+
+    sigemptyset (&empty);
+    posix_spawnattr_setsigmask (&attr, &empty);
+
+    sigemptyset (&dfl);
+    sigaddset (&dfl, SIGINT);
+    sigaddset (&dfl, SIGQUIT);
+    sigaddset (&dfl, SIGTERM);
+    sigaddset (&dfl, SIGCHLD);
+    posix_spawnattr_setsigdefault (&attr, &dfl);
+
+    if (job_control && (flags & FORK_NOJOB) == 0)
+      {
+	posix_spawnattr_setpgroup (&attr, pipeline_pgrp);  /* 0 => new pgrp = child */
+	f |= POSIX_SPAWN_SETPGROUP;
+      }
+    posix_spawnattr_setflags (&attr, f);
+  }
+
+  /* Translate the in-child fd setup (close_fd_bitmap + do_piping) into
+     posix_spawn file actions, applied in the child before exec. Order matches
+     bash: close the inherited pipe fds of other stages first, then wire this
+     stage's pipe_in->0 / pipe_out->1 (or 1->2 for REDIRECT_BOTH). */
+  posix_spawn_file_actions_init (&fa);
+  have_fa = 0;
+
+  if (fds_to_close)
+    for (i = 0; i < fds_to_close->size; i++)
+      if (fds_to_close->bitmap[i])
+	{ posix_spawn_file_actions_addclose (&fa, i); have_fa = 1; }
+
+  if (pipe_in != NO_PIPE)
+    {
+      posix_spawn_file_actions_adddup2 (&fa, pipe_in, 0);
+      if (pipe_in > 0)
+	posix_spawn_file_actions_addclose (&fa, pipe_in);
+      have_fa = 1;
+    }
+  if (pipe_out != NO_PIPE)
+    {
+      if (pipe_out != REDIRECT_BOTH)
+	{
+	  posix_spawn_file_actions_adddup2 (&fa, pipe_out, 1);
+	  if (pipe_out == 0 || pipe_out > 1)
+	    posix_spawn_file_actions_addclose (&fa, pipe_out);
+	}
+      else
+	posix_spawn_file_actions_adddup2 (&fa, 1, 2);
+      have_fa = 1;
+    }
+
+  r = posix_spawn (&pid, path, have_fa ? &fa : (posix_spawn_file_actions_t *)NULL,
+		   &attr, argv, envp ? envp : environ);
+  posix_spawn_file_actions_destroy (&fa);
+  posix_spawnattr_destroy (&attr);
+
+  if (r != 0)
+    {
+      errno = r;
+      sys_error ("posix_spawn: %s", path);
+      sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+      return (-1);
+    }
+
+  /* Parent-side bookkeeping — identical to make_child's parent branch. */
+  chibil_register_spawned (command, pid, flags, async_p, &oset);
+  return (pid);
+}
+#endif /* CHIBIL_REEXEC */
+
