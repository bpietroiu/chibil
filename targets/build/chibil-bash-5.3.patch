+#if defined (CHIBIL_REEXEC)
+/* Build a NULL-terminated environment array carrying ALL shell variables
+   (exported or not) and ALL shell functions, so the full shell state can be
+   handed to a re-exec'd command-substitution / subshell child through its
+   environment. Non-exported scalars become (exported) vars in the child;
+   functions are BASH_FUNC_-encoded and auto-imported at child startup. Arrays
+   cannot pass through the environment and are skipped. Caller frees with
+   strvec_dispose.
+
+   NOTE (M-fork-2b, blocked): the array this builds is correct (verified: valid
+   name=value entries incl. non-exported vars), but a `dotnet bash.dll` child
+   spawned via posix_spawnp with a CUSTOM envp does not receive it — the child's
+   environment comes up empty (whereas passing `environ` works). Until that
+   dotnet/host env-delivery quirk is understood, chibil_spawn_comsub keeps
+   passing export_env/environ (M-fork-2a), so session-exported / non-exported
+   vars do not reach comsub children yet. */
+char **
+chibil_make_full_env (void)
+{
+  SHELL_VAR **vars, **funcs;
+  char **venv, **fenv, **full;
+  int nv, nf, i, k;
+
+  vars = all_shell_variables ();
+  venv = vars ? make_env_array_from_var_list (vars) : (char **)NULL;
+  if (vars)
+    free (vars);
+
+  funcs = all_shell_functions ();
+  fenv = funcs ? make_env_array_from_var_list (funcs) : (char **)NULL;
+  if (funcs)
+    free (funcs);
+
+  nv = venv ? strvec_len (venv) : 0;
+  nf = fenv ? strvec_len (fenv) : 0;
+  full = strvec_create (nv + nf + 1);
+  k = 0;
+  for (i = 0; i < nv; i++)
+    full[k++] = venv[i];	/* move ownership of the strings into `full` */
+  for (i = 0; i < nf; i++)
+    full[k++] = fenv[i];
+  full[k] = (char *)NULL;
+  if (venv)
+    free (venv);		/* free the containers, not the moved strings */
+  if (fenv)
+    free (fenv);
+  return full;
+}
+#endif /* CHIBIL_REEXEC */
+
+#if defined (CHIBIL_REEXEC)
+/* Serialize shell state a command-substitution / subshell child needs into a
+   chunk of re-executable shell code: every defined function (re-readable
+   `name () { ... }`), then every NON-exported scalar variable as `name='value'`
+   (exported vars already reach the child through the environment; readonly,
+   dynamic, array and function vars are skipped). Prepended to the child's `-c`
+   body so the child defines them before running the body — this sidesteps the
+   environment entirely (a custom posix_spawn envp does not survive to a
+   dotnet-launched child). Caller frees the returned string; NULL if nothing. */
+char *
+chibil_state_dump (void)
+{
+  SHELL_VAR **vars, **funcs;
+  char *out, *piece, *q, *val;
+  size_t len, cap, plen;
+  int i;
+
+  out = (char *)NULL; len = 0; cap = 0;
+
+#define CHIBIL_APPEND(s, slen) \
+  do { \
+      size_t _n = (slen); \
+      if (len + _n + 1 > cap) { cap = (len + _n + 1) * 2 + 128; out = (char *)xrealloc (out, cap); } \
+      memcpy (out + len, (s), _n); len += _n; out[len] = '\0'; \
+  } while (0)
+
+  funcs = all_shell_functions ();
+  if (funcs)
+    {
+      for (i = 0; funcs[i]; i++)
+	{
+	  if (invisible_p (funcs[i]))
+	    continue;
+	  /* static buffer — copy immediately, do not free. */
+	  piece = named_function_string (funcs[i]->name, function_cell (funcs[i]),
+					 FUNC_MULTILINE|FUNC_EXTERNAL);
+	  if (piece == 0)
+	    continue;
+	  plen = strlen (piece);
+	  CHIBIL_APPEND (piece, plen);
+	  CHIBIL_APPEND ("\n", 1);
+	}
+      free (funcs);
+    }
+
+  vars = all_shell_variables ();
+  if (vars)
+    {
+      for (i = 0; vars[i]; i++)
+	{
+	  SHELL_VAR *v = vars[i];
+
+	  if (invisible_p (v) || exported_p (v) || readonly_p (v) || function_p (v))
+	    continue;
+	  if (array_p (v) || assoc_p (v))
+	    continue;
+	  if (v->dynamic_value)			/* RANDOM, SECONDS, LINENO, … */
+	    continue;
+	  val = value_cell (v);
+	  if (val == 0)
+	    continue;
+	  q = sh_single_quote (val);
+	  CHIBIL_APPEND (v->name, strlen (v->name));
+	  CHIBIL_APPEND ("=", 1);
+	  CHIBIL_APPEND (q, strlen (q));
+	  CHIBIL_APPEND ("\n", 1);
+	  free (q);
+	}
+      free (vars);
+    }
+
+  /* Positional parameters ($1, $2, …): a comsub body inside a function or script
+     frequently references them (e.g. `$(f $(($1-1)))`), and the re-exec'd child
+     otherwise has none. Emit `set -- 'a' 'b' …`. */
+  {
+    WORD_LIST *pp, *l;
+
+    pp = list_rest_of_args ();
+    if (pp)
+      {
+	CHIBIL_APPEND ("set --", 6);
+	for (l = pp; l; l = l->next)
+	  {
+	    q = sh_single_quote (l->word->word);
+	    CHIBIL_APPEND (" ", 1);
+	    CHIBIL_APPEND (q, strlen (q));
+	    free (q);
+	  }
+	CHIBIL_APPEND ("\n", 1);
+	dispose_words (pp);
+      }
+  }
+#undef CHIBIL_APPEND
+
+  return out;
+}
+#endif /* CHIBIL_REEXEC */
